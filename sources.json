{
  "_doc": "新闻源配置。domain: ai / livelihood / society_cn / society_intl。tier: 1=官方权威(官方发布，默认可信度极高) / 2=主流·行业标杆(有采编规范) / 3=一般媒体·商业媒体(可能有商业立场) / 4=未知·自媒体(未登记来源默认最低)。type: official / mainstream / international / industry / other。tier 与 type 直接决定可信度自动判定，未写 tier 的源按 tier 4 处理。每条源 rss 优先，rss 为空/失败/停更则按 web 爬网页。enabled=false 表示本机实测不可用（网络不可达或源已停更），换到有代理的环境后可改回 true。可用 python probe_sources.py 复测。",
  "settings": {
    "timeout": 10,
    "max_per_source": 12,
    "lookback_hours": 72,
    "workers": 6
  },
  "module_filters": {
    "_doc": "可选：给某个模块配关键词门，**标题**命中任意一个才收进该模块（只看标题，避免摘要里的背景词把无关条目带进来）。中文关键词按子串匹配，纯英文关键词按整词匹配（避免 ai 命中 said）。留空表示不过滤。",
    "ai": [
      "ai", "人工智能", "大模型", "大语言模型", "模型", "算法", "机器学习", "深度学习",
      "神经网络", "智能体", "生成式", "多模态", "数据集", "推理模型",
      "agent", "agentic", "llm", "gpt", "chatgpt", "openai", "anthropic", "claude",
      "gemini", "deepmind", "midjourney", "sora", "copilot", "qwen", "deepseek",
      "豆包", "通义", "文心", "英伟达", "nvidia", "gpu", "算力", "机器人",
      "自动驾驶", "语音识别", "图像生成", "aigc", "智能体平台"
    ]
  },
